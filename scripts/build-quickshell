#!/usr/bin/env bash
# Build the redistributable Ubuntu package in the isolated build container.
set -euo pipefail
out=${1:?output directory required}
mkdir -p "$out"
out=$(realpath "$out")
export DEBIAN_FRONTEND=noninteractive
apt-get install -y --no-install-recommends dpkg-dev cmake ninja-build g++ pkg-config qt6-base-private-dev qt6-declarative-private-dev qt6-wayland-private-dev qt6-shadertools-dev libdrm-dev libcli11-dev libjemalloc-dev libwayland-dev wayland-protocols libpipewire-0.3-dev libpam0g-dev libpolkit-agent-1-dev libxcb1-dev libxcb-render0-dev libxcb-shape0-dev spirv-tools libvulkan-dev libgbm-dev libgl-dev libegl-dev qt6-wayland-dev qt6-svg-dev
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
rev=2b4501a282689792b62e94f3fb30d8f512324fe6
curl -fsSL --retry 3 "https://api.github.com/repos/quickshell-mirror/quickshell/tarball/$rev" -o "$work/src.tgz"
echo "d4eeb3510ee052f271552a495a82d51e1a1005dda6f3b06ff0abef0d1645b8cc  $work/src.tgz" | sha256sum -c -
mkdir "$work/src"
tar --strip-components=1 -xf "$work/src.tgz" -C "$work/src"
cmake -S "$work/src" -B "$work/build" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DDISTRIBUTOR='Framework Hypr Desktop' -DINSTALL_QML_PREFIX=lib/qt6/qml -DCRASH_HANDLER=OFF
cmake --build "$work/build" --parallel 2
pkg="$work/package"
DESTDIR="$pkg" cmake --install "$work/build"
mkdir -p "$pkg/DEBIAN" "$pkg/usr/share/doc/framework-quickshell" "$work/debian"
cp "$work/src/LICENSE" "$work/src/LICENSE-GPL" "$pkg/usr/share/doc/framework-quickshell/"
cat > "$work/debian/control" <<'CONTROL'
Source: framework-quickshell
Section: x11
Priority: optional
Maintainer: Framework Hypr Desktop <framework-hypr@users.noreply.github.com>

Package: framework-quickshell
Architecture: amd64
Description: Native Quickshell runtime for the Framework Hypr Desktop
CONTROL
cd "$work"
deps=$(dpkg-shlibdeps -O -e"$pkg/usr/bin/quickshell")
qt=$(dpkg-query -W -f='${Version}' libqt6core6t64 | cut -d+ -f1)
next=$(awk -F. '{printf "%d.%d.%d", $1, $2, $3+1}' <<<"$qt")
cat >"$pkg/DEBIAN/control" <<CONTROL
Package: framework-quickshell
Version: 0.3.2+git2b4501a-1
Architecture: amd64
Maintainer: Framework Hypr Desktop <framework-hypr@users.noreply.github.com>
Depends: ${deps#shlibs:Depends=}, libqt6core6t64 (>= $qt), libqt6core6t64 (<< $next~)
Description: Quickshell runtime built against Ubuntu's Qt private ABI
CONTROL
dpkg-deb --root-owner-group --build "$pkg" "$out/framework-quickshell.deb"
cp "$work/src.tgz" "$out/quickshell-source.tgz"
